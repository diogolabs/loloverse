# Copie para /opt/loloverse-pb/.env na VM Oracle com permissão `chmod 600` e dono `pocketbase:pocketbase`.
# NUNCA commite o arquivo `.env` real no Git!

# Endereço privado de escuta (use 127.0.0.1:8090 ou o gateway da rede Docker do cloudflared, ex: 172.18.0.1:8090)
PB_HTTP_ADDR=127.0.0.1:8090

# Bootstrap único da conta de Admin escolar (login por e-mail/senha fora do modo Google).
# Requisito de segurança: senha com NO MÍNIMO 14 caracteres.
# Após o primeiro start do serviço, APAGUE LOLOVERSE_ADMIN_PASSWORD deste arquivo!
LOLOVERSE_ADMIN_EMAIL=admin@seudominio.com.br
LOLOVERSE_ADMIN_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_COM_14_OU_MAIS_CARACTERES
LOLOVERSE_ADMIN_NAME=Admin Loloverse
